{
  "manifest_version": 3,
  "name": "MSE Inspection Autofill",
  "version": "1.2.0",
  "description": "Fills MSE internal audit report chapters from the Annexure II Excel. Runs locally; your data never leaves your computer.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://inspection-os.msei.in/*", "http://inspection-os.msei.in/*", "file:///*", "http://localhost/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MSE Inspection Autofill",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://inspection-os.msei.in/*", "http://inspection-os.msei.in/*", "file:///*", "http://localhost/*"],
      "js": ["fill.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
